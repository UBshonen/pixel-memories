{
  // Cloudflare Workers 배포 설정
  //
  // 이 파일이 없으면 배포 설정이 대시보드에만 남는다. 그러면 나중에
  // "왜 이렇게 설정했더라"를 알 수 없고, 다른 사람이 같은 환경을 못 만든다.
  // 설정을 코드로 남기는 것을 Infrastructure as Code 라고 한다.

  "$schema": "node_modules/wrangler/config-schema.json",

  // 배포 주소가 된다 → https://pixel-memories.<계정>.workers.dev
  "name": "pixel-memories",

  // Workers 런타임의 동작 기준 날짜.
  // 런타임이 업데이트돼도 이 날짜의 동작을 유지해 주므로,
  // 어느 날 갑자기 깨지는 일이 없다.
  "compatibility_date": "2026-08-21",

  // 서버에서 실행할 코드가 없다. 파일만 나눠주는 정적 사이트다.
  // main 을 적지 않으면 static-only Worker 가 된다.
  "assets": {
    // next build 결과물이 나오는 폴더 (next.config.ts 의 output: "export")
    "directory": "./out"
  }
}
